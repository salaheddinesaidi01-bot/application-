# Configuration du serveur
PORT=3000

# Configuration PostgreSQL
PGHOST=localhost
PGPORT=5432
PGDATABASE=gestion_cours
PGUSER=postgres
PGPASSWORD=postgres

# Ou alternative via DATABASE_URL
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/gestion_cours

# Configuration SMTP (Nodemailer pour envoi du relevé de clôture mensuelle)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=votre_email@gmail.com
SMTP_PASS=votre_mot_de_passe_application
EMAIL_FROM="Mme Trari - Cours de Soutien" <votre_email@gmail.com>
